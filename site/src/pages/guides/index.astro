---
import Doc from '../../layouts/Doc.astro';
import { GUIDES, GUIDE_GROUPS } from '../../data/guides';
import { SITE, CTA_LABEL } from '../../data/site';
const list = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'PostDelegate guides', url: `${SITE.url}/guides`, hasPart: GUIDES.map((guide) => ({ '@type': 'Article', headline: guide.title, url: `${SITE.url}/guides/${guide.slug}` })) };
const sections = GUIDE_GROUPS.map((group) => ({ group, guides: GUIDES.filter((guide) => guide.group === group) })).filter((section) => section.guides.length);
---
<Doc title="Guides: Schedule Posts with AI and MCP | PostDelegate" description="Step-by-step guides for scheduling posts with Claude and ChatGPT, safe AI agents, Slack, Twitch, Nostr, WordPress and DEV.to, CSV imports and client approvals." h1="Guides for planning, scheduling and automating your posts." eyebrow="Guides" lead="Practical walkthroughs that follow what PostDelegate does today. Each one links to the matching channel page and documentation." jsonLd={[list]}>
  <a slot="actions" href={SITE.signup} data-pulse-goal="trial_clicked" class="button">{CTA_LABEL}</a>
  <a slot="actions" href="/docs" class="button button-outline">Read the docs</a>
  {sections.map((section) => (
    <>
      <h2>{section.group}</h2>
      <div class="document-grid">
        {section.guides.map((guide) => <a class="document-card" href={`/guides/${guide.slug}`}><h3>{guide.title}</h3><p>{guide.description}</p><span>Read the guide</span></a>)}
      </div>
    </>
  ))}
</Doc>
