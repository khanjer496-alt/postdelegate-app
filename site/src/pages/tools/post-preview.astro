---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.astro';
import { NETWORKS } from '../../data/networks';
import { SITE, CTA_LABEL } from '../../data/site';
import AppShot from '../../components/AppShot.astro';
// Limits and counting rules come from NETWORKS. `fold` marks a feed that hides long text behind
// "…more"; the numbers are an approximation of a typical desktop feed, not a platform rule.
const FOLD: Record<string, { chars: number; lines: number }> = { linkedin: { chars: 210, lines: 3 } };
const cards = ['bluesky', 'mastodon', 'threads', 'linkedin'].map((key) => NETWORKS.find((n) => n.key === key)!).map((n) => ({
  key: n.key, name: n.name, limit: n.limit, available: Boolean(n.available), fold: FOLD[n.key] ?? null,
  rule: { unit: n.unit, urlCost: n.urlCost, noMentionDomain: n.noMentionDomain },
}));
const url = `${SITE.url}/tools/post-preview`;
const app = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Social media post preview', applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, url };
const faq = [
  { q: 'What does the post preview show?', a: 'It shows your caption on simple cards for Bluesky, Mastodon, Threads and a LinkedIn-style feed, with the character count for each, the part of the text that runs over a limit, where a long post folds behind “…more”, and where a link card would appear. It also counts your hashtags, mentions and links.' },
  { q: 'Is the preview exactly what people will see?', a: 'No. The cards are deliberately plain and approximate. Each network renders posts its own way, and the point where a feed folds a long post depends on the screen, the font and the app. Use the preview to catch text that is too long or buried, then check the final post in the composer.' },
  { q: 'How many hashtags should I use?', a: 'There is no single right number, and each network treats hashtags differently. A few relevant hashtags at the end usually read better than many in the middle of a sentence. The counter here helps you keep the number consistent across posts.' },
  { q: 'Is my caption sent anywhere?', a: 'No. The preview runs in your browser. Nothing you type is uploaded or saved.' },
  { q: 'Which of these networks can PostDelegate post to?', a: 'Bluesky and Mastodon can be connected today. Threads and LinkedIn are waiting on approval and can’t be connected yet. The <a href="/platforms">platform directory</a> shows everything you can connect right now.' },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })) };
const field = 'w-full rounded-xl border border-line-hover bg-surface-1 px-4 py-3 text-ink placeholder:text-ink-3 focus:border-brand-300';
---
<Base title="Social media post preview tool | PostDelegate" description="Preview a caption on Bluesky, Mastodon, Threads and LinkedIn-style cards: see where text folds, what runs over the limit, and count hashtags and links." jsonLd={[app, faqLd]}>
  <PageHero eyebrow="Free tool" title="Social media post preview" lead="See how a caption reads on Bluesky, Mastodon, Threads and a LinkedIn-style feed before you post it. It runs in your browser; nothing is sent or saved." />
  <section class="section"><div id="preview" class="container-x" data-cards={JSON.stringify(cards)}>
    <div class="grid gap-10 lg:grid-cols-[minmax(0,420px)_minmax(0,1fr)]">
      <div class="grid content-start gap-5">
        <div><label for="cap" class="mb-2 block text-sm font-bold">Your caption</label>
          <textarea id="cap" rows="9" class="w-full rounded-2xl border border-line-hover bg-surface-1 p-4 text-base text-ink placeholder:text-ink-3 focus:border-brand-300" placeholder="Write or paste your caption here…"></textarea></div>
        <div><label for="link" class="mb-2 block text-sm font-bold">Link for the card <span class="font-normal text-ink-3">(optional)</span></label>
          <input id="link" type="url" autocomplete="off" placeholder="https://example.com/article" aria-describedby="link-note" class={field} />
          <p id="link-note" class="mt-2 text-xs text-ink-3">Leave empty to use the first link in your caption.</p></div>
        <button id="example" type="button" class="btn btn-ghost w-fit">Try an example</button>
        <dl id="stats" class="grid grid-cols-3 gap-3">
          {[['chars', 'Characters'], ['words', 'Words'], ['tags', 'Hashtags'], ['mentions', 'Mentions'], ['links', 'Links'], ['lines', 'Lines']].map(([id, label]) => (
            <div class="rounded-xl border border-line bg-surface p-3"><dt class="text-xs text-ink-3">{label}</dt><dd id={`s-${id}`} class="mt-1 text-lg font-bold tabular-nums text-ink">0</dd></div>
          ))}
        </dl>
        <p id="s-summary" class="sr-only" aria-live="polite"></p>
      </div>
      <ul id="cards" class="grid content-start gap-4 md:grid-cols-2" aria-label="Previews">
        {cards.map((c) => (
          <li class="card !p-5" data-key={c.key}>
            <div class="flex items-center gap-3">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-surface-3 text-sm font-bold text-ink-2" aria-hidden="true">Y</span>
              <div class="min-w-0 leading-tight"><p class="font-bold text-ink">Your name</p><p class="text-xs text-ink-3">@you</p></div>
              <span class="ml-auto rounded-full border border-line-hover px-3 py-1 text-xs font-semibold text-ink-2">{c.name}{c.fold ? '-style' : ''}</span>
            </div>
            <div class="body mt-4 whitespace-pre-wrap break-words text-[15px] leading-relaxed text-ink"><span class="text-ink-3">Your caption appears here.</span></div>
            <div class="linkcard mt-4 overflow-hidden rounded-xl border border-line" hidden>
              <div class="flex aspect-[1.91/1] items-center justify-center bg-surface-3 text-xs font-semibold uppercase tracking-widest text-ink-3" aria-hidden="true">Link image</div>
              <div class="p-3"><p class="domain text-xs text-ink-3"></p><p class="text-sm font-semibold text-ink-2">The page title appears here</p></div>
            </div>
            <div class="mt-4 flex items-center gap-2 border-t border-line pt-3 text-xs">
              <span class="count tabular-nums text-ink-3">0 / {c.limit.toLocaleString('en-US')}</span>
              <span class="state ml-auto text-ink-3">{c.available ? 'Connect today' : 'Not live on PostDelegate yet'}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="prose-pd mt-14 max-w-3xl">
      <h2>How to use the post preview</h2>
      <ol>
        <li>Write or paste your caption. Hashtags, mentions and links are highlighted, and the counters above the cards update as you type.</li>
        <li>Add the link you want to share, or leave the field empty to use the first link in the caption. A placeholder card shows where the link preview would sit.</li>
        <li>Read each card. Text past a network’s limit is marked in red, and the LinkedIn-style card folds long text behind “…more”, so make sure the first lines carry the point.</li>
      </ol>
      <p>Counts are planning estimates that follow the same rules as the <a href="/tools/caption-checker">caption checker</a>. The fold point is an approximation of a typical desktop feed. Cards are deliberately plain and are not a copy of any network’s design.</p>
    </div>

    <div class="mt-14 max-w-3xl">
      <h2 class="mb-6 text-[27px] font-bold tracking-tight">Questions</h2>
      <Faq items={faq} />
    </div>

    <div class="prose-pd mt-12 max-w-3xl">
      <h2>Related</h2>
      <ul>
        <li><a href="/bluesky-scheduler">Bluesky scheduler</a> and the guide to <a href="/guides/schedule-bluesky-posts">scheduling Bluesky posts</a></li>
        <li><a href="/tools/thread-splitter">Thread splitter</a> for posts that run over the limit</li>
        <li><a href="/tools/caption-checker">Caption checker</a> and <a href="/guides/social-media-character-limits">social media character limits</a></li>
        <li><a href="/tools/utm-builder">UTM link builder</a> to tag the link before you share it</li>
      </ul>
      <p>Ready to schedule it? <a href={SITE.signup} data-pulse-goal="trial_clicked">{CTA_LABEL}</a>. No card is needed.</p>
    </div>
    <AppShot
      shot="composer"
      caption="The same preview inside PostDelegate, next to the post as you write it."
    />
  </div></section>
  <CtaBand title="Write it once, plan it everywhere." text="Draft a post, adjust it for each channel and schedule it on one calendar. Try PostDelegate free for 7 days, no card needed." />
</Base>
<script>
  import { captionLength, TOKEN_START, type Rule } from '../../scripts/caption-count';
  type Card = { key: string; name: string; limit: number; available: boolean; fold: { chars: number; lines: number } | null; rule: Rule };
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const cards: Card[] = JSON.parse($('preview').dataset.cards!);
  const cap = $<HTMLTextAreaElement>('cap'), link = $<HTMLInputElement>('link');
  const items = Array.from(document.querySelectorAll<HTMLElement>('#cards > li'));
  const TOKEN = new RegExp(TOKEN_START + String.raw`(?:https?:\/\/[^\s<>]*[^\s<>.,;:!?'")\]}]|#[\p{L}\p{N}_]+|@[A-Za-z0-9_]+(?:[A-Za-z0-9_.-]*[A-Za-z0-9_])?(?:@[\p{L}\p{N}_.-]*[\p{L}\p{N}_])?)`, 'gu');
  const EXAMPLE = 'We just published our guide to planning a month of social media in one afternoon.\n\nIt covers how to pick three themes, batch your drafts and leave room for news, with a template you can copy.\n\nRead it here: https://example.com/guides/plan-a-month\n\n#socialmedia #contentplanning @postdelegate';
  let seg: Intl.Segmenter | null = null;
  const graphemes = (t: string) => { if (typeof Intl.Segmenter !== 'function') return Array.from(t); seg ??= new Intl.Segmenter(undefined, { granularity: 'grapheme' }); return Array.from(seg.segment(t), (s) => s.segment); };

  // Append text with hashtags, mentions and links highlighted, without using innerHTML.
  const rich = (parent: Node, text: string) => {
    let pos = 0;
    for (const m of text.matchAll(TOKEN)) {
      if (m.index! > pos) parent.appendChild(document.createTextNode(text.slice(pos, m.index)));
      const span = document.createElement('span'); span.className = 'text-brand-200'; span.textContent = m[0]; parent.appendChild(span);
      pos = m.index! + m[0].length;
    }
    if (pos < text.length) parent.appendChild(document.createTextNode(text.slice(pos)));
  };

  // The longest prefix, in whole graphemes, that fits the limit under the network's counting rule.
  const fitIndex = (g: string[], rule: Rule, limit: number) => {
    let lo = 0, hi = g.length;
    while (lo < hi) { const mid = Math.ceil((lo + hi) / 2); if (captionLength(g.slice(0, mid).join(''), rule) <= limit) lo = mid; else hi = mid - 1; }
    return lo;
  };
  const foldIndex = (g: string[], fold: { chars: number; lines: number }) => {
    let breaks = 0;
    for (let i = 0; i < g.length && i < fold.chars; i++) if (g[i] === '\n' && ++breaks >= fold.lines) return i;
    return Math.min(g.length, fold.chars);
  };

  const cardLink = (text: string) => {
    const raw = link.value.trim() || (text.match(TOKEN) ?? []).find((t) => /^https?:/.test(t)) || '';
    try { const u = new URL(raw); return /^https?:$/.test(u.protocol) ? u.hostname.replace(/^www\./, '') : ''; } catch { return ''; }
  };

  const draw = (li: HTMLElement, c: Card, text: string, domain: string) => {
    const body = li.querySelector('.body') as HTMLElement;
    body.replaceChildren();
    if (!text.trim()) { const p = document.createElement('span'); p.className = 'text-ink-3'; p.textContent = 'Your caption appears here.'; body.append(p); }
    else {
      const g = graphemes(text.replace(/\s+$/, ''));
      const fit = fitIndex(g, c.rule, c.limit);
      const fold = c.fold ? foldIndex(g, c.fold) : g.length;
      const shown = Math.min(fit, fold);
      rich(body, g.slice(0, shown).join(''));
      const folded = fold < fit;
      const rest = document.createElement('span'); rest.hidden = folded;
      if (folded) {
        rich(rest, g.slice(fold, fit).join(''));
        const more = document.createElement('button'); more.type = 'button'; more.className = 'font-semibold text-ink-3 underline-offset-4 hover:text-ink hover:underline'; more.textContent = '…more';
        more.setAttribute('aria-label', 'Show the rest of the caption');
        more.addEventListener('click', () => { rest.hidden = false; more.remove(); });
        body.append(more);
      }
      if (fit < g.length) {
        const over = document.createElement('span'); over.className = 'rounded bg-red-500/20 text-red-200 line-through decoration-red-300/60';
        const sr = document.createElement('span'); sr.className = 'sr-only'; sr.textContent = ' Over the limit: ';
        over.append(sr); rich(over, g.slice(fit).join(''));
        rest.append(over);
      }
      body.append(rest);
    }
    const card = li.querySelector('.linkcard') as HTMLElement;
    card.hidden = !domain; (card.querySelector('.domain') as HTMLElement).textContent = domain;
    const n = captionLength(text, c.rule);
    const count = li.querySelector('.count') as HTMLElement;
    count.textContent = `${n.toLocaleString('en-US')} / ${c.limit.toLocaleString('en-US')}`;
    count.className = 'count tabular-nums ' + (n > c.limit ? 'font-bold text-red-300' : 'text-ink-3');
    const state = li.querySelector('.state') as HTMLElement;
    state.textContent = n > c.limit ? `${(n - c.limit).toLocaleString('en-US')} over the limit` : c.available ? 'Connect today' : 'Not live on PostDelegate yet';
    state.className = 'state ml-auto ' + (n > c.limit ? 'font-bold text-red-300' : 'text-ink-3');
  };

  const update = () => {
    const text = cap.value;
    const tokens = text.match(TOKEN) ?? [];
    const stat = (id: string, n: number) => { $(`s-${id}`).textContent = n.toLocaleString('en-US'); };
    stat('chars', graphemes(text).length);
    stat('words', (text.trim().match(/\S+/g) ?? []).length);
    stat('tags', tokens.filter((t) => t.startsWith('#')).length);
    stat('mentions', tokens.filter((t) => t.startsWith('@')).length);
    stat('links', tokens.filter((t) => /^https?:/.test(t)).length);
    stat('lines', text.trim() ? text.trim().split('\n').length : 0);
    $('s-summary').textContent = text.trim() ? [['chars', 'Characters'], ['tags', 'hashtags'], ['mentions', 'mentions'], ['links', 'links']].map(([id, label]) => `${label}: ${$(`s-${id}`).textContent}`).join(', ') + '.' : '';
    const domain = cardLink(text);
    items.forEach((li) => draw(li, cards.find((c) => c.key === li.dataset.key)!, text, domain));
  };
  let timer = 0;
  [cap, link].forEach((el) => el.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(update, 80); }));
  $('example').addEventListener('click', () => { cap.value = EXAMPLE; link.value = ''; update(); });
</script>
