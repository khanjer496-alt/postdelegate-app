---
import Doc from '../../layouts/Doc.astro';
import { SITE } from '../../data/site';
import { localizeLinks, strings, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings(lang);
const p = t.claudePage;
---
<Doc title={p.title} description={p.description} h1={p.h1} eyebrow={p.eyebrow} lead={p.lead} lang={lang}>
  <a slot="actions" href={SITE.signup} data-pulse-goal="trial_clicked" class="button">{t.common.ctaLabel}</a>
  <a slot="actions" href="/docs/mcp/claude" class="button button-outline">{p.connect}</a>
  <Fragment set:html={localizeLinks(lang, p.body)} />
</Doc>
