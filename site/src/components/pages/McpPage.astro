---
import Doc from '../../layouts/Doc.astro';
import { SITE } from '../../data/site';
import { AVAILABLE_NETWORKS } from '../../data/networks';
import { localizeLinks, strings, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings(lang);
const p = t.mcpPage;
---
<Doc title={p.title} description={p.description(AVAILABLE_NETWORKS.length)} h1={p.h1} eyebrow={p.eyebrow} lead={p.lead} lang={lang}>
  <a slot="actions" href="/docs/mcp" class="button">{p.readDocs}</a>
  <a slot="actions" href={SITE.signup} data-pulse-goal="trial_clicked" class="button button-outline">{t.common.ctaLabel}</a>
  <Fragment set:html={localizeLinks(lang, p.body)} />
</Doc>
