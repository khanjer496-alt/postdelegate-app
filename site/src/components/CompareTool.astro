---
// Template for /compare/{a}-vs-{b}: two other tools head to head, facts from src/data/tools/*.json.
// The page file supplies the words (short answer, sections, FAQ, links); the tables come from the data.
// PostDelegate is kept out of the A vs B table and gets its own box below it.
import Doc from '../layouts/Doc.astro';
import Faq from './Faq.astro';
import FactCell from './compare/FactCell.astro';
import PostDelegateFit from './compare/PostDelegateFit.astro';
import CompareNotes from './compare/CompareNotes.astro';
import { tool, checkedOn, comparisonJsonLd, COST_POINTS, type Tool } from '../data/tools';
interface Row { label: string; key: keyof Tool }
interface Props {
  a: string; b: string; title: string; description: string; h1: string; shortAnswer: string;
  rows?: Row[]; costIntro?: string; fitIntro: string; faq: { q: string; a: string }[];
  links: { href: string; label: string }[]; published: string;
}
const { a, b, title, description, h1, shortAnswer, rows: extraRows = [], costIntro, fitIntro, faq, links, published } = Astro.props;
const left = tool(a);
const right = tool(b);
const pair = [left, right];
const checked = checkedOn(pair);
const modified = [published, checked].sort().at(-1)!;
const path = `/compare/${a}-vs-${b}`;
// Every comparison page says that PostDelegate is open source (AGPL-3.0).
const namesPostiz = true;
const rows: Row[] = [
  { label: 'What it is', key: 'kind' },
  { label: 'Hosting', key: 'hosting' },
  { label: 'Pricing model', key: 'pricingModel' },
  { label: 'Plans', key: 'plans' },
  { label: 'Free option', key: 'freeOption' },
  { label: 'Trial', key: 'trial' },
  { label: 'Networks', key: 'networks' },
  { label: 'API', key: 'api' },
  { label: 'MCP for AI agents', key: 'mcp' },
  { label: 'AI writing', key: 'ai' },
  { label: 'Teams and approvals', key: 'teams' },
  { label: 'License', key: 'license' },
  ...extraRows,
];
const jsonLd = comparisonJsonLd({ path, title: h1, description, section: { name: 'Compare', path: '/compare' }, faq, published, modified });
---
<Doc title={title} description={description} h1={h1} eyebrow="Compare" jsonLd={jsonLd}>
  <a slot="actions" href={left.pricingUrl} class="button button-outline" target="_blank" rel="noopener">{left.name} pricing</a>
  <a slot="actions" href={right.pricingUrl} class="button button-outline" target="_blank" rel="noopener">{right.name} pricing</a>
  <h2>Short answer</h2>
  <p class="short-answer">{shortAnswer}</p>
  <CompareNotes tools={pair} checked={checked} namesPostiz={namesPostiz} />

  <h2>At a glance</h2>
  <p class="ct-hint" aria-hidden="true">Scroll sideways to see both tools →</p>
  <div class="ct-scroll">
    <table class="ct-table">
      <caption class="sr-only">{left.name} compared with {right.name}</caption>
      <thead><tr><th scope="col">Feature</th><th scope="col">{left.name}</th><th scope="col">{right.name}</th></tr></thead>
      <tbody>{rows.filter((row) => left[row.key] || right[row.key]).map((row) => <tr><th scope="row">{row.label}</th><td><FactCell fact={left[row.key] as never} vendor={left.name} /></td><td><FactCell fact={right[row.key] as never} vendor={right.name} /></td></tr>)}</tbody>
    </table>
  </div>

  <h2>Cost at 3, 10 and 30 accounts</h2>
  {costIntro && <p>{costIntro}</p>}
  <p class="ct-hint" aria-hidden="true">Scroll sideways to see both tools →</p>
  <div class="ct-scroll">
    <table class="ct-table">
      <caption class="sr-only">Monthly cost of {left.name} and {right.name} by number of connected accounts</caption>
      <thead><tr><th scope="col">Accounts</th><th scope="col">{left.name}, per month</th><th scope="col">{right.name}, per month</th></tr></thead>
      <tbody>{COST_POINTS.map((n) => <tr><th scope="row">{n}</th><td><FactCell fact={left.cost?.[n]} vendor={left.name} /></td><td><FactCell fact={right.cost?.[n]} vendor={right.name} /></td></tr>)}</tbody>
    </table>
  </div>
  <p class="ct-small">Monthly billing, before tax. Each figure is worked out from the plan prices on the linked pricing page.</p>

  <slot />

  <PostDelegateFit intro={fitIntro} />

  <h2>FAQ</h2>
  <Faq items={faq} />

  <h2>Related</h2>
  <ul class="ct-links">{links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
  <p class="ct-small">{left.name} and {right.name} are trademarks of their owners. PostDelegate is not affiliated with or endorsed by either. Last updated <time datetime={modified}>{modified}</time>.</p>
</Doc>
<style>
  .short-answer { padding: 20px 24px; border-left: 3px solid #c8ff4d; border-radius: 0 14px 14px 0; background: #171717; color: #e6e6e6; font-size: 17px; line-height: 1.75; }
  .ct-scroll { margin: 22px 0; overflow-x: auto; border: 1px solid #303030; border-radius: 18px; background: #171717; }
  .ct-table { width: 100%; min-width: 36rem; border-collapse: collapse; font-size: 14px; line-height: 1.65; }
  .ct-table thead th { background: #222; color: #fff; font-size: 12px; letter-spacing: .06em; text-transform: uppercase; }
  .ct-table th, .ct-table td { padding: 13px 16px; border-bottom: 1px solid #2a2a2a; text-align: left; vertical-align: top; }
  .ct-table tbody tr:last-child > * { border-bottom: 0; }
  .ct-table tbody th { width: 22%; color: #fff; font-weight: 700; }
  .ct-table td { color: #c4c4c4; }
  .ct-small { color: #9a9a9a; font-size: 13px !important; }
  .ct-hint { display: none; margin: 0 0 -12px !important; color: #9a9a9a; font-size: 12px !important; text-align: right; }
  .ct-links { columns: 2; column-gap: 32px; }
  @media (max-width: 640px) { .ct-hint { display: block; } }
  @media (max-width: 600px) { .ct-links { columns: 1; } .short-answer { font-size: 16px; padding: 16px 18px; } }
</style>
