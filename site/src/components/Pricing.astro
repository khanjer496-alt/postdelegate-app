---
import { PLANS, TRIAL_DAYS, planPerks } from '../data/plans';
import { SITE } from '../data/site';
import { AVAILABLE_NETWORKS, FEATURED_LIVE_NETWORKS } from '../data/networks';
import LogoStack from './LogoStack.astro';
import Icon from './Icon.astro';
import { localizeLinks, strings, type Lang } from '../i18n';
interface Props { heading?: boolean; lang?: Lang }
const { heading = true, lang = 'en' } = Astro.props;
const t = strings(lang);
const p = t.pricing;
const num = (value: number, digits = 0) => value.toLocaleString(t.numberLocale, { minimumFractionDigits: digits, maximumFractionDigits: digits });
// The yearly saving, worked out from plans.ts rather than typed in.
const savings = PLANS.map((plan) => (plan.monthly * 12 - plan.yearly) / (plan.monthly * 12));
const bestSaving = Math.round(Math.max(...savings) * 100);
const perMonth = (yearly: number) => { const value = yearly / 12; return num(value, Number.isInteger(value) ? 0 : 2); };
const maxChannels = num(Math.max(...PLANS.map((plan) => plan.maxChannels || plan.channels)));
const lowest = Math.min(...PLANS.map((plan) => plan.monthly));
// Stroke icons for the perk list (24x24, drawn with currentColor).
const icons: Record<string, string> = {
  team: 'M16 19v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 17.5V19M10 10.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM20 19v-1.4a3.3 3.3 0 0 0-2.4-3.2M15.5 4.6a3 3 0 0 1 0 5.8',
  solo: 'M18 19v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 6 17.5V19M12 10.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z',
  posts: 'M5 5h14v14H5zM5 9h14M9 13h6M9 16h4',
  agent: 'M8 9h8M8 13h5M5 4h14v12H9l-4 4z',
  webhook: 'M13 3 5 13h6l-1 8 8-10h-6z',
  studio: 'M7 3h10v18H7zM10 9l4 3-4 3z',
  ai: 'M14.5 4.5a4 4 0 1 1-3.9 4.8L4 16v4h4v-2h2v-2h2l1.2-1.2',
};
---
<div class="pricing">
  {heading && (
    <div class="pricing-heading">
      <p class="eyebrow">{p.eyebrow}</p>
      <h2>{p.heading(lowest)}</h2>
      <p class="muted">{p.intro(TRIAL_DAYS)}</p>
    </div>
  )}
  {/* pricing_viewed fires when half of it is on screen: the switch right above
      the plans, since half of the whole block never fits on a phone */}
  <fieldset class="billing-toggle" data-pulse-scroll="pricing_viewed">
    <legend class="sr-only">{p.billingPeriod}</legend>
    <input type="radio" name="billing-period" id="billing-monthly" value="monthly" checked />
    <label for="billing-monthly">{p.monthly}</label>
    <input type="radio" name="billing-period" id="billing-yearly" value="yearly" />
    <label for="billing-yearly">{p.yearly} <span>{p.saveUpTo(bestSaving)}</span></label>
  </fieldset>
  <div class="plan-grid">
    {PLANS.map((plan) => (
      <article class:list={['plan-card', { 'plan-featured': plan.popular }]}>
        <div class="plan-topline">
          <h3>{plan.name}</h3>
          {plan.popular && <span class="plan-badge">{p.recommended}</span>}
        </div>
        <p class="plan-tagline">{t.planTaglines[plan.slug]}</p>
        <p class="plan-price price-monthly"><strong>${plan.monthly}</strong><span>{p.perMonth}</span></p>
        <p class="plan-yearly price-monthly">{p.orYearly(num(plan.yearly), num(plan.monthly * 12 - plan.yearly))}</p>
        <p class="plan-price price-yearly"><strong>${perMonth(plan.yearly)}</strong><span>{p.perMonth}</span></p>
        <p class="plan-yearly price-yearly">{p.billedYearly(num(plan.yearly), num(plan.monthly * 12 - plan.yearly))}</p>
        <a href={SITE.signup} class:list={['button', { 'button-outline': !plan.popular }]} data-pulse-goal="plan_clicked" data-pulse-goal-plan={plan.slug}>{p.startTrial}</a>
        <p class="plan-trial">{p.trialNote(TRIAL_DAYS)}</p>
        <div class="plan-channels">
          <p><strong>{plan.channels}</strong> {p.channels}{plan.extraChannelMonthly && <span class="plan-extra price-monthly">{p.extraMonthly(num(plan.extraChannelMonthly), num(plan.maxChannels || plan.channels))}</span>}{plan.extraChannelYearly && <span class="plan-extra price-yearly">{p.extraYearly(num(plan.extraChannelYearly, 2), num(plan.maxChannels || plan.channels))}</span>}</p>
          <div class="plan-networks"><LogoStack networks={FEATURED_LIVE_NETWORKS} max={5} size="xs" decorative lang={lang} /><small>{p.anyLive(AVAILABLE_NETWORKS.length)}</small></div>
        </div>
        <ul class="plan-perks">
          {planPerks(plan, t.perks, t.numberLocale).map((perk) => (
            <li>
              <span class="perk-icon" aria-hidden="true">{perk.icon === 'agent' ? <Icon name="claude" class="size-4" /> : <svg viewBox="0 0 24 24"><path d={icons[perk.icon]} /></svg>}</span>
              <span>{perk.text}{perk.note && <small>{perk.note}</small>}</span>
            </li>
          ))}
        </ul>
        <p class="plan-every">{p.everyPlanTitle}</p>
        <ul class="plan-every-list">{p.everyPlan.map((item) => <li>{item}</li>)}</ul>
      </article>
    ))}
  </div>
  <div class="plan-custom">
    <div><h3>{p.customTitle}</h3><p>{p.customText(maxChannels)}</p></div>
    <a href={`mailto:${SITE.email}?subject=${encodeURIComponent(p.customSubject)}`} class="button button-outline">{p.talkToUs}</a>
  </div>
  <p class="pricing-note muted"><strong>{p.whyTitle}</strong> {p.whyText}</p>
  <p class="pricing-note muted" set:html={localizeLinks(lang, p.note)} />
</div>
<style>
  .pricing-heading { text-align: center; max-width: 760px; margin: 0 auto 40px; }
  .pricing-heading h2 { font-size: clamp(32px, 4.6vw, 54px); line-height: 1.08; font-weight: 800; letter-spacing: -.045em; margin: 16px 0 20px; text-wrap: balance; }
  .pricing-heading > p:last-child { line-height: 1.75; font-size: 17px; text-wrap: pretty; }
  .billing-toggle { display: flex; justify-content: center; gap: 4px; width: fit-content; margin: 0 auto 28px; padding: 4px; border: 1px solid #383838; border-radius: 999px; background: #151515; }
  .billing-toggle input { position: absolute; opacity: 0; pointer-events: none; }
  .billing-toggle label { display: inline-flex; align-items: center; gap: 8px; min-height: 42px; padding: 0 18px; border-radius: 999px; color: #b9b9b9; font-size: 14px; font-weight: 650; cursor: pointer; }
  .billing-toggle label span { color: #c8ff4d; font-size: 12px; font-weight: 700; }
  .billing-toggle input:checked + label { background: #f3f3f3; color: #151515; }
  .billing-toggle input:checked + label span { color: #3d6b00; }
  .billing-toggle input:focus-visible + label { outline: 2px solid var(--accent, #7357ff); outline-offset: 2px; }
  .plan-card .price-yearly { display: none; }
  .pricing:has(#billing-yearly:checked) .plan-card .plan-price.price-yearly { display: flex; }
  .pricing:has(#billing-yearly:checked) .plan-card .plan-yearly.price-yearly { display: block; }
  .pricing:has(#billing-yearly:checked) .plan-card .plan-extra.price-yearly { display: block; }
  .pricing:has(#billing-yearly:checked) .plan-card .price-monthly { display: none; }
  .plan-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; align-items: stretch; }
  .plan-card { position: relative; display: flex; flex-direction: column; padding: 26px 22px 24px; border: 1px solid #2f2f2f; border-radius: 24px; background: linear-gradient(180deg, #19181d, #141414 40%); color: #fff; --stack-ring: #161616; }
  .plan-featured { border-color: transparent; background: linear-gradient(180deg, #1f1a33, #15131b 45%) padding-box, linear-gradient(160deg, #c8ff4d, #7357ff 55%, #2e2a3a) border-box; border: 1.5px solid transparent; box-shadow: 0 30px 70px -30px #7357ff80; --stack-ring: #18161e; }
  .plan-topline { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .plan-topline h3 { font-size: 22px; line-height: 1.2; font-weight: 800; letter-spacing: -.03em; }
  .plan-badge { padding: 5px 10px; border-radius: 100px; background: #c8ff4d; color: #111; font-size: 11px; line-height: 1.2; font-weight: 800; }
  .plan-tagline { margin-top: 6px; color: #b9b9b9; font-size: 14px; line-height: 1.5; }
  .plan-price { display: flex; align-items: baseline; gap: 6px; margin-top: 22px; }
  .plan-price strong { font-size: 46px; line-height: 1; font-weight: 800; letter-spacing: -.05em; }
  .plan-price span { color: #b9b9b9; font-size: 14px; }
  .plan-yearly { margin-top: 8px; color: #a8a8a8; font-size: 12.5px; line-height: 1.5; }
  .plan-card .button { width: 100%; margin-top: 22px; min-height: 48px; color: #fff; border-color: #5a5a5a; background: transparent; }
  .plan-card .button:hover { color: #151515; background: #fff; border-color: #fff; }
  .plan-featured .button { color: #111; background: #c8ff4d; border-color: #c8ff4d; }
  .plan-featured .button:hover { color: #111; background: #d8ff80; border-color: #d8ff80; }
  .plan-trial { margin-top: 9px; color: #9a9a9a; font-size: 12px; text-align: center; }
  .plan-channels { margin-top: 22px; padding: 14px; border: 1px solid #2c2c2c; border-radius: 16px; background: #ffffff06; }
  .plan-channels > p { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 6px; color: #e6e6e6; font-size: 15px; font-weight: 650; }
  .plan-channels strong { color: #fff; font-size: 24px; font-weight: 800; letter-spacing: -.03em; }
  .plan-extra { flex-basis: 100%; color: #c8ff4d; font-size: 12.5px; font-weight: 650; }
  .plan-networks { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin-top: 10px; }
  .plan-networks small { color: #a8a8a8; font-size: 11.5px; }
  .plan-perks { display: grid; gap: 11px; margin: 20px 0 0; padding: 0; list-style: none; font-size: 13.5px; line-height: 1.5; color: #e2e2e2; }
  .plan-perks li { display: flex; align-items: flex-start; gap: 10px; }
  .plan-perks small { display: block; color: #9a9a9a; font-size: 12px; }
  .perk-icon { display: grid; place-items: center; flex: none; width: 26px; height: 26px; border-radius: 8px; background: #7357ff24; color: #d1bfff; }
  .plan-featured .perk-icon { background: #c8ff4d1f; color: #c8ff4d; }
  .perk-icon svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .plan-every { margin-top: 20px; padding-top: 16px; border-top: 1px solid #2c2c2c; color: #9a9a9a; font-size: 11.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .plan-every-list { display: grid; gap: 8px; margin: 12px 0 0; padding: 0; list-style: none; color: #cfcfcf; font-size: 13px; line-height: 1.45; }
  .plan-every-list li { display: flex; gap: 9px; }
  .plan-every-list li::before { content: '✓'; flex: none; color: #d1bfff; font-weight: 800; }
  .plan-featured .plan-every-list li::before { color: #c8ff4d; }
  .plan-custom { display: flex; align-items: center; justify-content: space-between; gap: 18px 28px; margin-top: 14px; padding: 22px 26px; border: 1px dashed #4a4a4a; border-radius: 22px; background: #121212; color: #fff; }
  .plan-custom h3 { font-size: 20px; font-weight: 800; letter-spacing: -.03em; }
  .plan-custom p { margin-top: 6px; color: #b9b9b9; font-size: 14px; line-height: 1.7; }
  .plan-custom .button { flex: none; }
  .pricing-note { max-width: 750px; margin: 28px auto 0; text-align: center; font-size: 13px; line-height: 1.8; }
  .pricing-note :global(a) { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
  .pricing-note :global(strong) { color: #fff; font-weight: 700; }
  .pricing-note + .pricing-note { margin-top: 12px; }
  @media (max-width: 1100px) { .plan-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) {
    .pricing-heading { margin-bottom: 28px; }
    .pricing-heading > p:last-child { font-size: 15.5px; }
    .billing-toggle label { padding: 0 14px; font-size: 13px; }
    .plan-grid { grid-template-columns: 1fr; gap: 14px; }
    .plan-card { padding: 22px 20px; border-radius: 22px; }
    .plan-custom { flex-direction: column; align-items: flex-start; }
  }
</style>
