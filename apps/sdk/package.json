{
  "name": "@postdelegate/node",
  "version": "1.0.0",
  "description": "Official Node.js SDK for the PostDelegate social media scheduling API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "postdelegate",
    "social media",
    "scheduling",
    "sdk",
    "api"
  ],
  "homepage": "https://postdelegate.com",
  "author": "PostDelegate",
  "license": "AGPL-3.0"
}
