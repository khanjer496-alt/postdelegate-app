# Install as /etc/postiz/runtime.env, root:root 0600; never commit real values.
MAIN_URL=https://app.postdelegate.com
FRONTEND_URL=https://app.postdelegate.com
NEXT_PUBLIC_BACKEND_URL=https://app.postdelegate.com/api
JWT_SECRET=GENERATE_ON_SERVER
POSTIZ_DB_PASSWORD=GENERATE_ON_SERVER
TEMPORAL_DB_PASSWORD=GENERATE_ON_SERVER
IS_GENERAL=true
DISABLE_REGISTRATION=true
# Set false only when customer signup is ready; this opens Google AND local signup.
# Google web login uses the same credentials as the YouTube provider.
# Redirect URI: https://app.postdelegate.com/integrations/social/youtube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
NX_ADD_PLUGINS=false
STORAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=6ada63eb2f8c926ce2d7254c91006e70
CLOUDFLARE_BUCKETNAME=your-bucket-name
CLOUDFLARE_BUCKET_URL=https://media.postdelegate.com
CLOUDFLARE_REGION=auto
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_ACCESS_KEY=
UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads
API_LIMIT=30
# MCP/OAuth dynamic client registration: only these hosts (and their subdomains)
# can receive web redirect_uris. Loopback and private-use schemes (cursor, vscode,
# vscode-insiders, windsurf, claude, or reverse-DNS like com.example.app:/cb) are always
# allowed. The ChatGPT app uses a static client and needs no entry.
DCR_VERIFIED_DOMAINS=claude.ai,claude.com,chatgpt.com,openai.com
# Per-IP login/forgot/register limits read the client address from the proxy chain.
# Only set true once the origin accepts traffic from Cloudflare only (firewall or a
# Caddy remote_ip allowlist), otherwise CF-Connecting-IP can be forged.
# TRUST_CF_CONNECTING_IP=true
# Extra origins (comma separated) allowed to send cookie-authenticated writes,
# besides FRONTEND_URL and MAIN_URL. Normally empty.
# CSRF_TRUSTED_ORIGINS=
# Managed-provider cleanup defaults OFF. Complete authorization-lifecycle-operations.md
# before setting these; the history value must match the actual Temporal namespace.
# INTEGRATION_AUTHORIZATION_LIFECYCLE_ENABLED=true
# INTEGRATION_AUTHORIZATION_HISTORY_RETENTION_HOURS=24
# Social access/refresh tokens are encrypted at rest with this key (32 bytes, base64:
# openssl rand -base64 32). Back it up with this file; losing it makes stored tokens
# unreadable. See "Token encryption" in deploy/postdelegate/README.md before setting it.
# TOKEN_ENCRYPTION_KEY=
# Opt-in third-party analytics (off by default; the privacy policy says none are used):
# PLAUSIBLE_ENABLED=true
# DUB_ANALYTICS_ENABLED=true
# The daily analytics history (follower and post metric snapshots, 400-day
# retention) and the scheduled analytics emails run by default; set either to
# true to switch it off
# ANALYTICS_HISTORY_DISABLED=true
# ANALYTICS_REPORTS_DISABLED=true
# The day 1 and day 3 getting started emails of new trials run by default (with
# RUN_CRON); set true to switch them off
# TRIAL_ONBOARDING_EMAILS_DISABLED=true
# Add official Postiz provider credentials and email settings as configured.
